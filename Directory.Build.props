<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    The portable release is a single exe, so symbols go inside each assembly rather than
    beside it as .pdb files. Stack traces in the diagnostic log keep their line numbers.
  -->
  <PropertyGroup Condition="'$(Portable)' == 'true'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
